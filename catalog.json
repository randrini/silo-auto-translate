{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "com.randrini.silo-auto-translate",
        "version": "0.2.0",
        "silo_api_version": "v1",
        "capabilities": [
          {
            "type": "http_routes.v1",
            "id": "webhook-routes",
            "display_name": "Auto Translate",
            "description": "Receives signed rating.set webhooks and triggers SubExtractor to extract and translate subtitles to French."
          },
          {
            "type": "watch_sync_provider.v1",
            "id": "favorite-watcher",
            "display_name": "Auto Translate Favorites",
            "description": "Triggers SubExtractor when a profile favorites a movie or episode.",
            "watch_sync_provider": {
              "auth_methods": [
                2
              ],
              "export_favorites": true,
              "supported_media_types": [
                1,
                2
              ],
              "max_batch_size": 25
            }
          }
        ],
        "http_routes": [
          {
            "id": "webhook",
            "method": "POST",
            "path": "/webhook",
            "access": "public"
          },
          {
            "id": "webhook-token",
            "method": "POST",
            "path": "/webhook/*",
            "access": "public"
          },
          {
            "id": "status",
            "method": "GET",
            "path": "/status",
            "access": "admin"
          },
          {
            "id": "admin-page",
            "method": "GET",
            "path": "/admin/auto-translate",
            "access": "admin",
            "navigable": true,
            "navigation_label": "Auto Translate",
            "navigation_kind": "admin"
          },
          {
            "id": "admin-token",
            "method": "GET",
            "path": "/admin/auto-translate/token",
            "access": "admin"
          }
        ],
        "presentation": {
          "display_name": "Silo Auto Translate",
          "summary": "Rating a profile item triggers automatic French subtitle extraction and translation via SubExtractor.",
          "description_markdown": "When a profile rates an item, silo's notification system delivers a signed `rating.set` webhook to this plugin. The plugin verifies the HMAC signature, then asks SubExtractor to download the video, extract and translate its subtitles to French, and upload them back to silo as subtitle-provider subtitles.",
          "setup_markdown": "Install the plugin, then configure the SubExtractor connection (URL, API key, and the shared webhook secret). Copy the webhook URL shown on the plugin's admin page into **Settings \u2192 Notifications \u2192 Webhooks** and enable Ratings.",
          "homepage_url": "https://github.com/randrini/silo-auto-translate",
          "source_url": "https://github.com/randrini/silo-auto-translate",
          "support_url": "https://github.com/randrini/silo-auto-translate/issues",
          "changelog_url": "https://github.com/randrini/silo-auto-translate/releases",
          "publisher_name": "randrini",
          "publisher_url": "https://github.com/randrini",
          "license_spdx": "MIT"
        },
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "global_config_schema": [
          {
            "key": "subextractor",
            "title": "SubExtractor connection",
            "description": "Connection settings for the SubExtractor instance that performs extraction and translation.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"enabled\":{\"type\":\"boolean\",\"default\":true},\"subextractor_url\":{\"type\":\"string\",\"format\":\"uri\",\"maxLength\":4096},\"subextractor_api_key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096},\"webhook_secret\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096},\"webhook_secrets\":{\"type\":\"string\",\"maxLength\":16384}},\"required\":[\"subextractor_url\",\"subextractor_api_key\",\"webhook_secret\"],\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "enabled",
                  "label": "Enabled",
                  "description": "When off, the plugin ignores rating webhooks and favorite events until re-enabled.",
                  "control": 5,
                  "required": false,
                  "secret": false,
                  "default_value": true
                },
                {
                  "key": "subextractor_url",
                  "label": "SubExtractor URL",
                  "description": "Base URL of the SubExtractor instance (e.g. http://subextractor:8975). Plain HTTP is allowed only for private/local hosts.",
                  "control": 1,
                  "placeholder": "http://subextractor:8975",
                  "required": true,
                  "secret": false
                },
                {
                  "key": "subextractor_api_key",
                  "label": "SubExtractor API Key",
                  "description": "The WEB_UI_API_KEY of the SubExtractor instance. Sent as a Bearer token to /api/silo/process.",
                  "control": 3,
                  "required": true,
                  "secret": true
                },
                {
                  "key": "webhook_secret",
                  "label": "Webhook Secret",
                  "description": "Same value as SubExtractor's SILO_WEBHOOK_SECRET. Derives the auth token for the webhook URL (acts as secret id \"default\") and verifies the HMAC when the host forwards X-Silo-Signature.",
                  "control": 3,
                  "required": true,
                  "secret": true
                },
                {
                  "key": "webhook_secrets",
                  "label": "Additional Webhook Secrets",
                  "description": "Optional JSON object mapping secret id \u2192 secret for multiple silo webhook registrations, e.g. {\"subex\": \"whsec_...\"}. Each id gets its own derived auth token; entries take precedence over the default webhook_secret for matching ids.",
                  "control": 2,
                  "rows": 4,
                  "required": false,
                  "secret": true,
                  "placeholder": "{\"subex\": \"whsec_...\"}"
                }
              ],
              "submit_label": "Save SubExtractor connection"
            }
          }
        ]
      },
      "repo_url": "https://github.com/randrini/silo-auto-translate",
      "checksums_url": "https://github.com/randrini/silo-auto-translate/releases/download/v0.2.0/checksums.txt",
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/randrini/silo-auto-translate/releases/download/v0.2.0/plugin-linux-amd64",
          "checksum": "9974a802942ee7db9acf11370e418b77b0f1ea984398932fbe5fcca91ee942f9"
        },
        "linux/arm64": {
          "url": "https://github.com/randrini/silo-auto-translate/releases/download/v0.2.0/plugin-linux-arm64",
          "checksum": "1e2d00ff32971707dce2e2a7d81cca04a85dba2b14fb3822f5d645052ec040b7"
        },
        "darwin/arm64": {
          "url": "https://github.com/randrini/silo-auto-translate/releases/download/v0.2.0/plugin-darwin-arm64",
          "checksum": "a67382176d6279bc0ec8a2bf2b0a3bc0cf7cf6b748995dbe1624c0b7fdd51739"
        }
      }
    }
  ]
}
